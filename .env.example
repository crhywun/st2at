# HTTP listener
ST2AT_HOST=0.0.0.0
ST2AT_PORT=8000

# Optional proxy. Examples:
#   http://user:pass@127.0.0.1:8080
#   socks5h://user:pass@127.0.0.1:1080
ST2AT_PROXY=

# curl_cffi browser profile used for the upstream request
ST2AT_IMPERSONATE=chrome110

# Upstream request timeout in seconds
ST2AT_TIMEOUT=30

# Set to false only when a local TLS-intercepting proxy requires it
ST2AT_VERIFY_TLS=true
